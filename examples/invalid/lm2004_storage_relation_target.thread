# What is wrong: Storage relation references non-existent table/field 'missing_table.user_id'. Error displayed: error[LM2004]: Semantic error: Storage relation target 'missing_table.user_id' does not exist in Storage 'AppDatabase'.
Storage AppDatabase
{
    Engine "PostgreSQL"

    Table users
    {
        Fields
        {
            "id": "UUID"
        }
    }

    Table sessions
    {
        Fields
        {
            "id": "UUID"
            "user_id": "UUID"
        }

        Relations
        {
            sessions.user_id 1:N missing_table.user_id
        }
    }
}
