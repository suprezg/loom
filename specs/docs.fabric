version: "1.0"
output: "./docs"

documents:
  target: "design.md"
  title: "Architecture and Design"
  sections:
    heading: "1. System Layout"
    content: "Macro-architecture decisions and structural pattern choices. High-level bird's-eye view of why the system is organized this way."
    subsections:
      heading: "Context and Container Diagram"
      content: "High-level visual overview of application boundaries. Maps external user personas and third-party API integrations."
      heading: "Component Diagram"
      content: "Structural decomposition of core backend containers. Maps out internal logical modules, controllers, and services."
      specs:
        "specs/block_extractor.thread"
        "specs/command_line_resolution.thread"
        "specs/diagnostics_and_logger.thread"
        "specs/document_composer.thread"
        "specs/file_ingester.thread"
        "specs/file_writer.thread"
        "specs/inspector_and_dispatcher.thread"
        "specs/linter.thread"
        "specs/parser.thread"
        "specs/path_resolver.thread"
      heading: "System Diagram"
      content: "Complete visual layout of the entire engineering footprint. Maps physical networks, server clusters, and connected databases."
      heading: "Database Schemas"
      content: "Exact data blueprint, table structures, and relations. Defines precisely how and where system data is stored."
      specs:
        "specs/parser.thread"

    heading: "2. Tech Stack, Libraries and Frameworks"
    content: "Definitive list of programming languages, frameworks, and libraries. Technical justifications explaining why these tools were chosen to build the software."

    heading: "3. Deployment Pipeline"
    content: "Visual workflow diagram showing the automated deployment process. Step-by-step technical explanation of how code moves from GitHub to production."
    subsections:
      heading: "Deployment Diagram"
      content: "Physical hosting layout mapping servers, cloud resources, and CDN locations. Details environments (Dev, Staging, Prod) and physical infrastructure nodes."

  target: "workflow.md"
  title: "Operation and Validation"
  sections:
    heading: "1. Global Application Lifecycle"
    content: "Step-by-step lifecycle of what happens when the application first boots up. Global error handling, logging, and crash-recovery procedures across the system."
    specs:
      "specs/command_line_resolution.thread"

    heading: "2. Features"
    content: "Breakdown of every user-facing system capability and functional requirement and non functional requirement. Explicitly names the design patterns governing how each specific feature operates."
    subsections:
      heading: "Building or Weaving"
      specs:
        "specs/building.thread"
      heading: "Linting or Combing"
      specs:
        "specs/linting.thread"
      heading: "VS Code Extension"
      specs:
        "specs/vscode_extension.thread"
