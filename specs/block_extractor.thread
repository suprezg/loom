syntax = component

Component: "BlockExtractor"
  Note: [[Extracts diagram and note blocks from parsed behavior and component ASTs without re-parsing source strings.]]

  Diagram: "classDiagram" [[
    class BlockExtractor {
      +extractFromThread(threadAst: &ThreadAST) -> ExtractionResult
      -extractFromBehavior(behaviorAst: &BehaviorAST) -> ExtractionResult
      -extractFromComponent(componentAst: &ComponentAST) -> ExtractionResult
      -formatMermaidFence(rawContent: &str, diagramType: &str) -> String
    }
  ]]

  Invariants:
    * "ZeroReParsing: Block extraction MUST operate strictly on in-memory AST nodes and never trigger additional file I/O or string re-parsing."
    * "StructuralPreservation: Extracting or formatting blocks MUST leave the original source AST unmodified."
    * "MermaidFenceIntegrity: All extracted raw diagram blocks MUST be clean-trimmed and properly wrapped within standard markdown mermaid fences."

  Non-Functional:
    * "Speed: Extraction pass MUST complete in under 0.5ms per AST."
    * "Memory: Allocates memory only for extracted text structures without duplicating unused AST nodes."

  Models:
    Model: "ExtractedDiagram"
      Type: "Struct"
      Members:
        * "diagramType: String"
        * "rawContent: String"
        * "formattedMermaid: String"
        * "sourceContext: String"

    Model: "ExtractedNote"
      Type: "Struct"
      Members:
        * "content: String"
        * "sourceContext: String"

    Model: "ExtractionResult"
      Type: "Struct"
      Members:
        * "diagrams: Vec<ExtractedDiagram>"
        * "notes: Vec<ExtractedNote>"

  Contracts:
    Contract: "extractFromThread"
      Signature: "extractFromThread(threadAst: &ThreadAST) -> ExtractionResult"
      Inputs:
        * "threadAst: &ThreadAST"
      Outputs:
        * "result: ExtractionResult"
      Requires:
        * "threadAst is a valid parsed ThreadAST enum holding either a BehaviorAST or ComponentAST."
      Ensures:
        * "Returns an aggregated ExtractionResult containing all diagram and note blocks extracted from the AST."
      Precondition:
        * "threadAst reference is valid."
      Postcondition:
        * "Source AST remains untouched."
      Process:
        1. "Match variant of input threadAst."
        2. "If ThreadAST::Behavior, delegate to extractFromBehavior."
        3. "If ThreadAST::Component, delegate to extractFromComponent."
        4. "Return aggregated ExtractionResult."

    Contract: "extractFromBehavior"
      Signature: "extractFromBehavior(behaviorAst: &BehaviorAST) -> ExtractionResult"
      Inputs:
        * "behaviorAst: &BehaviorAST"
      Outputs:
        * "result: ExtractionResult"
      Requires:
        * "behaviorAst is a populated BehaviorAST node."
      Ensures:
        * "Collects all Note and Diagram blocks attached to Feature, Rule, and Scenario AST nodes."
      Precondition:
        * "behaviorAst reference is valid."
      Postcondition:
        * "All extracted diagram strings are formatted via formatMermaidFence."
      Process:
        1. "Initialize empty lists for diagrams and notes."
        2. "Traverse Feature node for optional Note block."
        3. "Iterate through Rule blocks to extract inner Note nodes."
        4. "Iterate through Scenario blocks to extract Scenario-level Notes and Diagram nodes."
        5. "Pass each raw diagram payload through formatMermaidFence to produce fenced Markdown output."
        6. "Return aggregated ExtractionResult."

    Contract: "extractFromComponent"
      Signature: "extractFromComponent(componentAst: &ComponentAST) -> ExtractionResult"
      Inputs:
        * "componentAst: &ComponentAST"
      Outputs:
        * "result: ExtractionResult"
      Requires:
        * "componentAst is a populated ComponentAST node."
      Ensures:
        * "Collects all Note and Diagram blocks attached to Component, Models, and Contracts nodes."
      Precondition:
        * "componentAst reference is valid."
      Postcondition:
        * "All extracted diagram strings are formatted via formatMermaidFence."
      Process:
        1. "Initialize empty lists for diagrams and notes."
        2. "Extract top-level Component Note and Diagram nodes."
        3. "Traverse Models list and extract Model-level Note blocks."
        4. "Traverse Contracts list and extract Contract-level Note and Diagram blocks."
        5. "Format all raw diagram blocks using formatMermaidFence."
        6. "Return aggregated ExtractionResult."

    Contract: "formatMermaidFence"
      Signature: "formatMermaidFence(rawContent: &str, diagramType: &str) -> String"
      Inputs:
        * "rawContent: &str"
        * "diagramType: &str"
      Outputs:
        * "fencedBlock: String"
      Requires:
        * "rawContent contains the raw body lines of a diagram block."
      Ensures:
        * "Returns a standard Markdown fenced string starting with triple backticks and mermaid tag."
      Precondition:
        * "rawContent is non-empty."
      Postcondition:
        * "Indentation is normalized and trailing whitespace is stripped."
      Process:
        1. "Strip leading and trailing empty lines from rawContent."
        2. "Normalize line indentations relative to the diagram header line."
        3. "Prepend '```mermaid\n' along with diagramType header line."
        4. "Append raw body lines followed by closing '```' fence."
        5. "Return resulting String buffer."