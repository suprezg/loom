syntax = component

Component: "SyntaxDispatcher"
  Note: [[Inspects file header rules and routes to the correct parser module based on syntax declarations.]]

  Diagram: "flowchart LR" [[
    Payload[File Payload] --> Inspect[Inspect Header]
    Inspect --> MatchBehavior{Is behavior?}
    MatchBehavior -- Yes --> ParseBehavior[Invoke ThreadParser with BehaviorAST]
    MatchBehavior -- No --> MatchComponent{Is component?}
    MatchComponent -- Yes --> ParseComponent[Invoke ThreadParser with ComponentAST]
    MatchComponent -- No --> Unknown[Return UnknownSyntaxType]
  ]]

  Invariants:
    * "StrictHeaderValidation: Every .thread file MUST contain a valid 'syntax = ' header before any body parsing occurs."
    * "DeterministicRouting: Files declared as 'syntax = behavior' MUST route exclusively to the behavior parser rules; files declared as 'syntax = component' MUST route exclusively to component parser rules."
    * "FailFastParsing: Dispatching MUST immediately abort and return a DispatchError upon encountering an invalid header or syntax mismatch."

  Non-Functional:
    * "Speed: Header inspection MUST execute in under 0.1ms per file."
    * "Allocation: String slicing used during inspection to avoid unnecessary heap allocations."

  Models:
    Model: "SyntaxType"
      Type: "Enum"
      Members:
        * "Behavior"
        * "Component"

    Model: "DispatchedThread"
      Type: "Struct"
      Members:
        * "path: String"
        * "syntaxType: SyntaxType"
        * "ast: ThreadAST"

    Model: "DispatchError"
      Type: "Enum"
      Members:
        * "MissingHeader"
        * "InvalidHeaderSyntax"
        * "UnknownSyntaxType"
        * "ParseFailure"

  Contracts:
    Contract: "inspect"
      Signature: "inspect(content: &str) -> Result<SyntaxType, DispatchError>"
      Inputs:
        * "content: &str"
      Outputs:
        * "syntaxType: Result<SyntaxType, DispatchError>"
      Requires:
        * "content is a well-formed UTF-8 text string representing thread file contents."
      Ensures:
        * "Returns the identified SyntaxType variant or an explicit DispatchError."
      Precondition:
        * "content string buffer is non-empty."
      Postcondition:
        * "String buffer state remains unaltered."
      Process:
        1. "Scan top lines of input content buffer, ignoring leading whitespace and blank lines."
        2. "Locate mandatory header statement starting with 'syntax = '."
        3. "If no 'syntax = ' token is found within top lines, return DispatchError::MissingHeader."
        4. "Extract value string following 'syntax = '."
        5. "Match value against known keyword strings: return SyntaxType::Behavior for 'behavior', SyntaxType::Component for 'component', or DispatchError::UnknownSyntaxType otherwise."

    Contract: "dispatch"
      Signature: "dispatch(payload: &FilePayload) -> Result<DispatchedThread, DispatchError>"
      Inputs:
        * "payload: &FilePayload"
      Outputs:
        * "result: Result<DispatchedThread, DispatchError>"
      Requires:
        * "payload contains a valid file relative path and loaded text content."
      Ensures:
        * "Returns a DispatchedThread containing path, verified SyntaxType, and populated ThreadAST."
      Precondition:
        * "payload.content is non-empty."
      Postcondition:
        * "Raw thread text is parsed into strongly-typed AST or explicit error is returned."
      Process:
        1. "Pass payload.content into inspect function to determine syntax type."
        2. "If inspect returns DispatchError, return error immediately."
        3. "Pass payload.content and determined SyntaxType to ThreadParser engine."
        4. "If ThreadParser fails, return DispatchError::ParseFailure containing line-numbered error."
        5. "Construct DispatchedThread using payload.path, identified SyntaxType, and generated ThreadAST."
        6. "Return Ok(DispatchedThread)."

    Contract: "dispatchBatch"
      Signature: "dispatchBatch(payloads: &[FilePayload]) -> Result<Vec<DispatchedThread>, DispatchError>"
      Inputs:
        * "payloads: &[FilePayload]"
      Outputs:
        * "results: Result<Vec<DispatchedThread>, DispatchError>"
      Requires:
        * "Slice of loaded FilePayload structures."
      Ensures:
        * "Returns a vector of DispatchedThread ASTs for all input payloads."
      Precondition:
        * "payloads slice is valid."
      Postcondition:
        * "All payloads are successfully parsed or execution halts on first error."
      Process:
        1. "Initialize empty vector for DispatchedThread items."
        2. "Iterate sequentially through input FilePayload slice."
        3. "Invoke dispatch for each FilePayload item."
        4. "On Ok(DispatchedThread), push result into vector."
        5. "On Err(DispatchError), short-circuit iteration and return error immediately."
        6. "Return Ok(Vec<DispatchedThread>)."