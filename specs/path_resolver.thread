syntax = component

Component: "PathResolver"
  Note: [[Canonicalizes directory path configurations and performs file existence safety checks.]]

  Diagram: "flowchart TD" [[
    Input[baseDir + relativeTarget] --> Join[Join paths]
    Join --> Canonicalize[canonicalize() path]
    Canonicalize --> Success{Success?}
    Success -- Yes --> VerifyExist[Verify file exists]
    VerifyExist --> LoomPath[Construct LoomPath]
    Success -- No --> Error[Return ResolverError]
  ]]

  Invariants:
    * "AbsoluteCompleteness: The 'absolute' field inside LoomPath MUST always represent a canonicalized, fully-qualified system path."
    * "CrossPlatformConsistency: Path separators MUST be normalized to standard separators regardless of target OS."
    * "ErrorImmutability: Invalid or non-existent path resolutions MUST return explicit ResolverError types without panicking."

  Non-Functional:
    * "Speed: Path canonicalization and existence checks MUST execute in under 1ms per path."
    * "Memory: Zero heap allocation loops; reuses std::path::PathBuf internal buffers."

  Models:
    Model: "LoomPath"
      Type: "Struct"
      Members:
        * "absolute: String"
        * "relative: String"

    Model: "ResolverError"
      Type: "Enum"
      Members:
        * "PathNotFound"
        * "CanonicalizationFailed"
        * "InvalidPathString"

  Contracts:
    Contract: "validatePath"
      Signature: "validatePath(target: &str) -> Result<bool, ResolverError>"
      Inputs:
        * "target: &str"
      Outputs:
        * "exists: bool"
      Requires:
        * "Target path string is well-formed."
      Ensures:
        * "Returns true if file exists on disk, false if missing or unreadable."
      Precondition:
        * "Path string is non-empty."
      Postcondition:
        * "System disk state remains unaltered."
      Process:
        1. "Convert target string into a standard OS path reference (std::path::Path)."
        2. "Execute filesystem metadata check (path.exists() and path.is_file())."
        3. "Return boolean result to calling pipeline."

    Contract: "resolvePath"
      Signature: "resolvePath(baseDir: &str, relativeTarget: &str) -> Result<LoomPath, ResolverError>"
      Inputs:
        * "baseDir: &str"
        * "relativeTarget: &str"
      Outputs:
        * "result: Result<LoomPath, ResolverError>"
      Requires:
        * "Base directory and relative target strings are provided."
      Ensures:
        * "Returns a LoomPath containing both the raw relative path and the canonical absolute path."
      Precondition:
        * "Base directory path string is valid."
      Postcondition:
        * "The resolved absolute path is verified on disk before returning."
      Process:
        1. "Parse baseDir and relativeTarget into PathBuf structures."
        2. "Join relativeTarget onto baseDir (baseDir.join(relativeTarget))."
        3. "Call OS canonicalization (canonicalize()) to resolve '.' and '..' relative symbols."
        4. "If canonicalization succeeds, construct and return LoomPath struct containing absolute and relative path strings."
        5. "If canonicalization fails or target is missing, return ResolverError::PathNotFound."

    Contract: "getParentDir"
      Signature: "getParentDir(filePath: &str) -> Result<String, ResolverError>"
      Inputs:
        * "filePath: &str"
      Outputs:
        * "parentDir: Result<String, ResolverError>"
      Requires:
        * "Target manifest file path string."
      Ensures:
        * "Returns directory path containing the target file."
      Precondition:
        * "File path string contains at least one parent component or valid working directory reference."
      Postcondition:
        * "Parent directory string is trimmed and normalized."
      Process:
        1. "Convert input path string to Path buffer."
        2. "Extract parent component via path.parent()."
        3. "If parent is empty, fall back to current working directory ('.')."
        4. "Return normalized directory path string or ResolverError::InvalidPathString if path is malformed."