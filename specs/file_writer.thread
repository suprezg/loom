syntax = component

Component: "FileWriter"
  Note: [[Creates parent directory hierarchies recursively and writes markdown buffers atomically to disk.]]

  Diagram: "flowchart TD" [[
    Start[Write Document] --> CheckDir{Does parent dir exist?}
    CheckDir -- No --> CreateDir[create_dir_all]
    CheckDir -- Yes --> Write[write content to path]
    CreateDir --> Write
    Write --> Success{Success?}
    Success -- Yes --> RecordPath[Push to writtenPaths]
    Success -- No --> Error[Return WriteError]
  ]]

  Invariants:
    * "DirectoryAutoCreation: Missing parent target directories MUST be created recursively prior to file creation."
    * "AtomicWrite: Output documents MUST be written completely to disk or fail cleanly without leaving corrupted partial buffers."
    * "ExactPathReporting: Returned path vectors MUST accurately reflect all target files written to the filesystem."

  Non-Functional:
    * "Speed: File write operations MUST complete in under 2ms per document."
    * "Safety: Gracefully overwrites existing documents without leaving orphaned temporary files."

  Models:
    Model: "WriteReport"
      Type: "Struct"
      Members:
        * "writtenPaths: Vec<String>"
        * "totalFiles: usize"

    Model: "WriteError"
      Type: "Enum"
      Members:
        * "DirectoryCreationFailed"
        * "FileWriteFailed"
        * "PermissionDenied"

  Contracts:
    Contract: "writeDocuments"
      Signature: "writeDocuments(documents: &[ComposedDocument]) -> Result<WriteReport, WriteError>"
      Inputs:
        * "documents: &[ComposedDocument]"
      Outputs:
        * "report: Result<WriteReport, WriteError>"
      Requires:
        * "Slice of ComposedDocument structures containing rendered Markdown content and target paths."
      Ensures:
        * "Writes document buffers to disk, creating directories as needed, and returns a WriteReport with all created file paths."
      Precondition:
        * "documents slice is non-empty and all target path strings are valid."
      Postcondition:
        * "Target files exist on disk with complete rendered content, or execution halts with an explicit WriteError."
      Process:
        1. "Initialize an empty vector for writtenPaths."
        2. "Iterate through each ComposedDocument item in the documents slice."
        3. "Extract the parent directory component from document.targetPath using std::path::Path."
        4. "If parent directory path does not exist on disk, execute std::fs::create_dir_all to generate directory hierarchy."
        5. "If directory creation fails due to permissions or invalid paths, return WriteError::DirectoryCreationFailed."
        6. "Write raw document.content text buffer to document.targetPath using std::fs::write."
        7. "If disk write operation fails, return WriteError::FileWriteFailed."
        8. "Push document.targetPath string into writtenPaths vector."
        9. "Construct WriteReport containing writtenPaths and totalFiles count equal to writtenPaths.len()."
        10. "Return Ok(WriteReport)."