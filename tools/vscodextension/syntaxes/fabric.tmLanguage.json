{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loom Fabric",
  "scopeName": "source.loom.fabric",
  "patterns": [
    {
      "name": "comment.line.number-sign.loom",
      "match": "#.*$"
    },
    {
      "name": "comment.block.loom",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "variable.language.special.loom",
      "match": "\\b(system)\\b"
    },
    {
      "name": "storage.type.loom",
      "match": "\\b(group)\\b"
    },
    {
      "name": "keyword.control.class.loom",
      "match": "\\b(Feature|Component|Storage|Protocol)\\b(?=\\.)"
    },
    {
      "name": "keyword.operator.assignment.loom",
      "match": "->|:"
    },
    {
      "name": "string.quoted.double.loom",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.loom",
          "match": "\\\\."
        }
      ]
    }
  ]
}